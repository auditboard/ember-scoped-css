{
  "name": "v2-addon-tsdown",
  "version": "0.0.0",
  "private": true,
  "description": "A v2 addon built with tsdown + @nullvoxpopuli/ember-rolldown, mirroring the strategy used by auditboard-frontend",
  "keywords": [
    "ember-addon"
  ],
  "type": "module",
  "files": [
    "addon-main.cjs",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run && pnpm test:fixture",
    "test:fixture": "pnpm build && compare-fixture fixtures/expected-dist dist",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.9.0",
    "@glimmer/component": "^2.0.0",
    "decorator-transforms": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@ember/library-tsconfig": "^1.1.3",
    "@nullvoxpopuli/ember-rolldown": "^2.7.0",
    "@tsdown/css": "0.22.9",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "compare-fixture": "^1.0.1",
    "ember-scoped-css": "workspace:*",
    "ember-source": "^6.5.0",
    "tsdown": "0.22.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {}
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
